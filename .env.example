# Vignan Vidyanikethan AI — example environment variables.
# Copy to .env locally or paste these into Render → Environment.
# Both STUDY_AI_* and VIGNAN_AI_* prefixes work; STUDY_AI_* is shown here.

# ---------------------------------------------------------------- server basics
STUDY_AI_HOST=0.0.0.0
STUDY_AI_PORT=4173
STUDY_AI_COOKIE_SECURE=false
STUDY_AI_ALLOWED_ORIGINS=
# Requests per IP per minute, in memory per server instance. Adjust for shared school networks.
STUDY_AI_AI_RATE_LIMIT=60
STUDY_AI_SEARCH_RATE_LIMIT=30
# Only set true behind a trusted proxy that appends the real client IP; Render is auto-detected.
# STUDY_AI_TRUST_PROXY=true

# ------------------------------------------------------- zero-budget AI router
# Add one or more free-tier keys PER PROVIDER. Paste several values into the
# singular secret separated by commas/newlines, or use the plural *_KEYS alias.
# Vignan deduplicates keys, tries them in order, and cools down a quota-limited
# key for KEY_COOLDOWN_MS before trying it again. Student keys are used only
# after all Render keys fail (or during an explicit Settings test).
STUDY_AI_FREE_ROUTER=true
STUDY_AI_FREE_ROUTER_ORDER=gemini,groq,cloudflare,openrouter,mistral,cohere,arena,primary
STUDY_AI_KEY_COOLDOWN_MS=60000
STUDY_AI_STUDENT_KEY_FALLBACK=true

# Gemini: free Flash / Flash-Lite row in Google AI Studio.
STUDY_AI_GEMINI_KEY=
STUDY_AI_GEMINI_KEYS=
STUDY_AI_GEMINI_MODEL=gemini-3.5-flash-lite
STUDY_AI_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai

# Groq: free developer tier, OpenAI-compatible.
STUDY_AI_GROQ_KEY=
STUDY_AI_GROQ_KEYS=
STUDY_AI_GROQ_MODEL=openai/gpt-oss-20b
STUDY_AI_GROQ_ENDPOINT=https://api.groq.com/openai/v1

# Cloudflare Workers AI: 10,000 free Neurons/day, OpenAI-compatible.
STUDY_AI_CLOUDFLARE_ACCOUNT_ID=
STUDY_AI_CLOUDFLARE_TOKEN=
STUDY_AI_CLOUDFLARE_TOKENS=
STUDY_AI_CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

# OpenRouter: openrouter/free auto-selects free models.
STUDY_AI_OPENROUTER_KEY=
STUDY_AI_OPENROUTER_KEYS=
STUDY_AI_OPENROUTER_MODEL=openrouter/free
STUDY_AI_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
STUDY_AI_OPENROUTER_REFERER=https://github.com/Techno-projects-cpu/Vignan-Vidyanikethan-AI

# Mistral: Free mode needs no card; limits are shown in the admin panel.
STUDY_AI_MISTRAL_KEY=
STUDY_AI_MISTRAL_KEYS=
STUDY_AI_MISTRAL_MODEL=open-mistral-nemo
STUDY_AI_MISTRAL_ENDPOINT=https://api.mistral.ai/v1

# Cohere: free trial key, ~1,000 calls/month (evaluation / non-commercial).
STUDY_AI_COHERE_KEY=
STUDY_AI_COHERE_KEYS=
STUDY_AI_COHERE_MODEL=command-r-08-2024
STUDY_AI_COHERE_ENDPOINT=https://api.cohere.ai/compatibility/v1

# Local AI needs NO server key. WebLLM downloads an open-weight model once in
# the browser; Ollama/LM Studio are separate keyless desktop options.
# STUDY_AI_LOCAL_MODEL=SmolLM2-360M-Instruct-q4f16_1-MLC

# Arena AI: OPTIONAL. Free-router keys are restricted to Claude Code/Desktop.
# Only use a workspace API key that is allowed to call the API from a server.
STUDY_AI_ARENA_KEY=
STUDY_AI_ARENA_KEYS=
STUDY_AI_ARENA_MODEL=coding-router-preview
STUDY_AI_ARENA_ENDPOINT=https://api.arena.ai

# Legacy single upstream (also supports kind=arena / ollama / anthropic).
STUDY_AI_AI_BASE_URL=
STUDY_AI_AI_MODEL=
STUDY_AI_AI_KEY=
STUDY_AI_AI_KEYS=
STUDY_AI_AI_KIND=openai
STUDY_AI_AI_EXTRA_HEADERS={}

# ----------------------------------------------------------- web search fallback
# Keyless outside search: the Wikipedia edition for the chosen language plus the
# DuckDuckGo Instant Answer API (Simple English Wikipedia is a last resort).
# Set false to disable it. New browser installs can turn fallback off in the
# composer; existing saved preferences are preserved.
STUDY_AI_WIKIPEDIA_SEARCH=true
# How many top result pages the server may read to quote a real passage (0-4).
STUDY_AI_SEARCH_READ_PAGES=2
# Optional JSON search provider (overrides Wikipedia when set).
STUDY_AI_SEARCH_URL=
STUDY_AI_SEARCH_TOKEN=
STUDY_AI_SEARCH_TOKEN_HEADER=Authorization

# ------------------------------------------------------------------ accounts
# local = zero-setup demo. supabase = production-friendly free tier.
STUDY_AI_ACCOUNTS_BACKEND=local
STUDY_AI_ACCOUNTS_FILE=server/data/accounts.json
STUDY_AI_SUPABASE_EMAIL_DOMAIN=students.vignanvidyanikethan.org

# Supabase values come from Project Settings → API.
# Created project: Vignan-Vidyanikethan-AI (ref dwmzbrrnqxzdoxrxbrna, ap-south-1).
# Supabase renamed its keys in 2025. The old names still work, and so do the new ones.
#   anon         -> publishable key, starts sb_publishable_…
#   service_role -> secret key,      starts sb_secret_…
# SUPABASE_ANON_KEY accepts either the publishable key or a legacy anon JWT.
# SUPABASE_SERVICE_ROLE_KEY accepts either a secret key or a legacy service-role JWT.
# The aliases SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY work too.
# Dashboard path: Settings -> API Keys (there is no separate Settings -> API page).
# The secret is server-only: set it in Render, never in browser code, chat or Git.
SUPABASE_URL=https://dwmzbrrnqxzdoxrxbrna.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
